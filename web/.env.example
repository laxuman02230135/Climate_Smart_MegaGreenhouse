# Copy this file to .env and provide your EMQX Cloud credentials locally.
# Never commit the populated .env file.
BACKEND_URL=http://localhost:3001
BACKEND_PUBLIC_WS_URL=
IDLE_LOGOUT_MINUTES=30
COOKIE_SECURE=false

MQTT_HOST=your-emqx-host
MQTT_PORT=8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_CLIENT_ID=greenhouse-prototype-dashboard
